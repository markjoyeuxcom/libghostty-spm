@@ -3883,6 +3883,15 @@ pub fn mouseCaptured(self: *Surface) bool {
     return self.io.terminal.flags.mouse_event != .none;
 }
 
+/// Returns true if the running program has enabled bracketed paste. This
+/// is the same reading completeClipboardPaste makes before it encodes.
+pub fn bracketedPaste(self: *Surface) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const opts: input.paste.Options = .fromTerminal(&self.io.terminal);
+    return opts.bracketed;
+}
