+    /// Returns true if the program running in the surface has enabled
+    /// bracketed paste (mode 2004), read the way a paste reads it. Without
+    /// it, text given to ghostty_surface_text reaches the program with
+    /// every newline as a carriage return, which a shell or a prompt takes
+    /// as Enter, so a host can ask before it sends several lines.
+    export fn ghostty_surface_bracketed_paste(surface: *Surface) bool {
+        return surface.core_surface.bracketedPaste();
+    }
