diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index 1a28eb8a2..bbed16618 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -2190,6 +2190,24 @@ pub const CAPI = struct {
         return surface.core_surface.bracketedPaste();
     }
 
+    /// Send text to the terminal as ghostty_surface_text does, but only as
+    /// one bracketed paste. The mode is read once, by the same snapshot the
+    /// encoding uses, so asking and pasting cannot disagree. Returns 0 when
+    /// the text was queued framed; 1 when the running program has bracketed
+    /// paste off, in which case nothing was written; 2 on an error, after
+    /// which some of the text may have been queued.
+    export fn ghostty_surface_text_framed(
+        surface: *Surface,
+        ptr: [*]const u8,
+        len: usize,
+    ) u8 {
+        const written = surface.core_surface.textFramedCallback(ptr[0..len]) catch |err| {
+            log.err("error in framed text callback err={}", .{err});
+            return 2;
+        };
+        return if (written) 0 else 1;
+    }
