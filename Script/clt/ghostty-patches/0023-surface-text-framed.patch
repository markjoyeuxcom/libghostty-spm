+/// Like textCallback, but only as one bracketed paste: false, with nothing
+/// written, when the running program has bracketed paste off.
+pub fn textFramedCallback(self: *Surface, text: []const u8) !bool {
+    // Crash metadata in case we crash in here
+    crash.sentry.thread_state = self.crashThreadState();
+    defer crash.sentry.thread_state = null;
+
+    return try self.completeClipboardPasteFramed(text, true, true);
+}
+
 /// Callback for when the surface is fully visible or not, regardless
 /// of focus state. This is used to pause rendering when the surface
 /// is not visible, and also re-render when it becomes visible again.
@@ -6240,12 +6250,26 @@ fn completeClipboardPaste(
     data: []const u8,
     allow_unsafe: bool,
 ) !void {
-    if (data.len == 0) return;
+    _ = try self.completeClipboardPasteFramed(data, allow_unsafe, false);
+}
+
+/// completeClipboardPaste with one more condition. With require_bracketed,
+/// the paste is made only when the snapshot the encoding uses says the
+/// program has bracketed paste on; otherwise nothing is written and false
+/// is returned. True when the data was queued (or was empty).
+fn completeClipboardPasteFramed(
+    self: *Surface,
+    data: []const u8,
+    allow_unsafe: bool,
+    require_bracketed: bool,
+) !bool {
+    if (data.len == 0) return true;
 
     const encode_opts: input.paste.Options = encode_opts: {
         self.renderer_state.mutex.lockUncancelable(global.io());
         defer self.renderer_state.mutex.unlock(global.io());
         const opts: input.paste.Options = .fromTerminal(&self.io.terminal);
+        if (require_bracketed and !opts.bracketed) return false;
 
         // If we have paste protection enabled, we detect unsafe pastes and return
         // an error. The error approach allows apprt to attempt to complete the paste
@@ -6312,6 +6336,8 @@ fn completeClipboardPaste(
             vec,
         ), .unlocked);
     };
+
+    return true;
 }
 
